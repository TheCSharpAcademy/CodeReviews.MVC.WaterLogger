@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<a button type="button" class="btn btn-success mb-3" asp-area="" asp-page="/Create">Add Record</a>

<table id="records" class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Records[0].Date)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Records[0].Food)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Records[0].Calories)
        </th>
        <th>
            Actions
        </th>
    </tr>
    </thead>
    <tbody>
    @foreach (var record in Model.Records)
    {
        <tr class="list-row">
            <td>
                @Html.DisplayFor(modelItem => record.Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => record.Food)
            </td>
            <td>
                @Html.DisplayFor(modelItem => record.Calories)
            </td>
            <td>
                <a button type="button" class="btn btn-danger" asp-page="./Delete" asp-route-id="@record.Id">Delete</a>
                <a button type="button" class="btn btn-primary" asp-page="./Update" asp-route-id="@record.Id">Edit</a>
            </td>
        </tr>
    }
    </tbody>
</table>
<div class="text-center total-calories">Total Calories: @ViewData["Total"]</div>